# Copy this file to .env and fill in real values.
# .env is git-ignored: never commit secrets.
#
# The backend reads .env by itself in development. Keep values simple: no quotes, no
# spaces, no "$" and no "\", so that Spring Boot and Docker Compose read them the same way.

# The site's administrator, an account that may add, change and delete flights.
# The backend creates or updates this account on every start, so changing the password
# here and restarting is how you rotate it.
# Username: 3 to 32 characters (letters, digits, dot, underscore, hyphen).
# Password: at least 12 characters.
# Leave both empty to run without an administrator; the site is then read-only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# More administrators, when one is not enough: name:password pairs separated by commas,
# for example ADDITIONAL_ADMINS=amy:a-long-password,ben:another-long-password
# The same rules apply. Someone removed from this list loses the role at the next start.
# ADDITIONAL_ADMINS=

# Whether visitors may create (regular, read-only) accounts. Defaults to true.
# REGISTRATION_ENABLED=false
