# Settings of the production site. Copy this file to .env, in this folder on the server,
# and fill it in. .env is git-ignored: never commit it.
#
# Keep values simple: no quotes, no spaces, no "$" and no "\".

# Where visitors reach the site.
#   flights.example.com   a domain name whose DNS A record already points to this server.
#                         Caddy then serves HTTPS and gets the certificate by itself.
#   :80                   plain HTTP on the server's IP address, for a first try without
#                         a domain. Do not sign in over the internet this way: the
#                         password would travel unencrypted.
SITE_ADDRESS=:80

# Password of the database. It never leaves the server. Use a long random one, for
# example the output of: openssl rand -hex 24
# It is set when the database is first created; docs/deployment.md says how to change it.
POSTGRES_PASSWORD=

# The site's administrator, an account that may add, change and delete flights.
# The application creates or updates this account on every start, so changing the
# password here and restarting is how you rotate it.
# Username: 3 to 32 characters (letters, digits, dot, underscore, hyphen).
# Password: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# More administrators, when one is not enough: name:password pairs separated by commas,
# for example ADDITIONAL_ADMINS=amy:a-long-password,ben:another-long-password
# The same rules apply. Someone removed from this list loses the role at the next start.
# ADDITIONAL_ADMINS=

# Whether visitors may create (read-only) accounts.
REGISTRATION_ENABLED=false

# Looking a flight number up in the flight form. Without a key the free ADSBDB is used: it
# knows the route and the airline, not the aircraft. A key switches to AeroDataBox, which
# also knows the aircraft but has a small free quota and only dates within a year of today.
# AERODATABOX_API_KEY=
# A direct AeroDataBox subscription (not through RapidAPI) needs these two as well:
# AERODATABOX_BASE_URL=https://api.aerodatabox.com
# AERODATABOX_API_KEY_HEADER=X-Api-Key
# How long a lookup may wait for the provider.
# FLIGHT_LOOKUP_TIMEOUT=8s

# Ports on the server. Change them only if something else already uses 80 or 443;
# HTTPS certificates can only be issued on the standard ports.
# HTTP_PORT=80
# HTTPS_PORT=443

# Memory ceiling of the application. The default suits a server with 1 GB of memory.
# JAVA_TOOL_OPTIONS=-Xmx320m
